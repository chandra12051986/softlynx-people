# Owner connection: runs migrations and seeds
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/softlynx_people
# Restricted connection the API uses; row-level security applies to it
APP_DATABASE_URL=postgresql://softlynx_app:change-me@localhost:5432/softlynx_people
APP_DB_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-string
PORT=3000
